# Copy to config.env, edit external services, then run: source config.env
# config.env is ignored by Git. Never put credentials in this template.

QDBO_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Repository inputs and ignored outputs.
export QDBO_BENCHMARK_ROOT="${QDBO_REPO_ROOT}/workloads/join_ordering"
export QDBO_RESULTS_ROOT="${QDBO_REPO_ROOT}/results"
export QDBO_EMBEDDING_DIR="${QDBO_RESULTS_ROOT}/embeddings"
export IS_QDBO_ROOT="${QDBO_REPO_ROOT}/workloads/index_selection"
export IS_QDBO_PIPELINE_DIR="${QDBO_REPO_ROOT}"
export IS_QDBO_FIXTURE_DIR="${IS_QDBO_ROOT}/fixtures/sf1_nopk_19q_e2_runtime"
export IS_QDBO_EXP_DIR="${QDBO_RESULTS_ROOT}/index_selection/sf1_nopk_19q_e2_runtime"
export IS_QDBO_PYTHON="$(command -v python)"

# Optional join-ordering PostgreSQL execution (JOB and CEB both use IMDB data).
export QDBO_JOB_DSN="host=localhost port=5432 dbname=imdbload user=YOUR_POSTGRES_USER"
export QDBO_DB_DSN="${QDBO_JOB_DSN}"

# Index-selection PostgreSQL settings. Keep PG_DSN and libpq values aligned.
export PGHOST="localhost"
export PGPORT="5432"
export PGUSER="YOUR_POSTGRES_USER"
export PGDATABASE="tpch_sf1_pkonly"
export PG_DSN="host=${PGHOST} port=${PGPORT} dbname=tpch_sf1_nopk user=${PGUSER}"
export IS_QDBO_SOURCE_DB="tpch_sf1_pkonly"
export IS_QDBO_DB_NOPK="tpch_sf1_nopk"

# Required only when generating/loading TPC-H data.
export TPCH_DBGEN_DIR="/absolute/path/to/tpch-dbgen"

unset QDBO_REPO_ROOT
